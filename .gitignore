# ---- macOS ------------------------------------------------------------------
.DS_Store
Icon?
._*
# `Icon?` ci-dessus (fichier spécial Finder "Icon\r") ignore aussi, par collision de casse
# (core.ignorecase=true sur macOS), notre dossier assets/icons/ — jamais suivi par git jusqu'ici
# alors que scripts/optimize-images.py l'alimente. On le réautorise explicitement.
!assets/icons/
!assets/icons/**

# ---- Éditeurs ---------------------------------------------------------------
.idea/
.vscode/
*.swp

# ---- Outils de test (le site lui-même n'a ni build ni dépendances) ----------
node_modules/
npm-debug.log*
*.log

# ---- Secrets : seul .env.example (valeurs factices) est versionné -----------
.env
.env.*
!.env.example

# ---- Claude Code : réglages/aperçus locaux et worktrees ---------------------
.claude/worktrees/
.claude/settings.local.json
.claude/launch.json
