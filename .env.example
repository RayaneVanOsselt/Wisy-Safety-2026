# =============================================================================
#  WISY SAFETY — Variables d'environnement (exemple) — AUCUNE vraie clé ici
# -----------------------------------------------------------------------------
#  Le site est statique (HTML/CSS/JS, sans build) : il n'y a pas de process
#  Node qui lit un fichier .env au runtime. Ces valeurs servent de RÉFÉRENCE
#  et doivent être reportées dans  js/supabase-config.js.
#
#  Si un jour vous ajoutez un build (Vite, Astro, Next…), ces noms sont prêts.
#
#  RAPPEL SÉCURITÉ :
#   • SUPABASE_ANON_KEY et EMAILJS_PUBLIC_KEY sont PUBLIQUES → OK côté client.
#   • SUPABASE_SERVICE_ROLE_KEY est SECRÈTE → jamais dans le repo ni le navigateur.
# =============================================================================

# ---- Supabase (public, protégé par la Row Level Security) -------------------
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIQUE
# Équivalents si vous passez à un framework type Next.js :
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIQUE

# ---- Supabase (SECRET — uniquement côté serveur, JAMAIS committé) -----------
# SUPABASE_SERVICE_ROLE_KEY=laisser_hors_du_repo

# ---- EmailJS (public — notification admin d'un nouvel avis) -----------------
EMAILJS_PUBLIC_KEY=VOTRE_CLE_PUBLIQUE_EMAILJS
EMAILJS_SERVICE_ID=VOTRE_SERVICE_ID
EMAILJS_TEMPLATE_ID_REVIEW=VOTRE_TEMPLATE_ID_AVIS
ADMIN_NOTIFY_EMAIL=info@wisysafety.be

# ---- Cloudflare Turnstile (facultatif, anti-spam) ---------------------------
# La site key est publique ; la secret key reste côté serveur (edge function).
TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=laisser_hors_du_repo

# =============================================================================
#  ASSISTANT WISY — enrichissement IA OPTIONNEL (route serveur /api/chat)
# -----------------------------------------------------------------------------
#  L'assistant fonctionne DÉJÀ sans rien de tout ceci : son cœur répond côté
#  client à partir des données du site (js/assistant/*). Les variables ci-dessous
#  n'activent que la reformulation en langage naturel via Claude, hébergée dans
#  une Supabase Edge Function (supabase/functions/chat). En cas d'absence ou
#  d'erreur, le site retombe automatiquement sur le cœur local.
#
#  ⚠️  ANTHROPIC_API_KEY est SECRÈTE : elle vit UNIQUEMENT dans les secrets de la
#      fonction (jamais dans js/, jamais dans le navigateur, jamais committée).
#      À définir avec :  supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# =============================================================================

# ---- Secrets de l'Edge Function (côté serveur uniquement) -------------------
# ANTHROPIC_API_KEY=laisser_hors_du_repo
ANTHROPIC_MODEL=claude-sonnet-5
# Origine autorisée pour le CORS de la fonction (votre domaine de production) :
ASSISTANT_ALLOWED_ORIGIN=https://www.wisysafety.be
# Limitation de débit (par IP) : nb de requêtes / fenêtre (secondes)
ASSISTANT_RATE_LIMIT=20
ASSISTANT_RATE_WINDOW=60

# ---- Côté client (PUBLIC) : URL publique de la fonction déployée -------------
# À reporter dans js/supabase-config.js -> WISY_CONFIG.ASSISTANT_API_URL
# (ou window.WISY_ASSISTANT_CONFIG.apiUrl). Vide = assistant 100 % local.
ASSISTANT_API_URL=https://VOTRE-PROJET.supabase.co/functions/v1/chat
